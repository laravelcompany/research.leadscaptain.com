APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=7001
DATABASE_PATH=/data/leads.db
AI_BASE_URL=https://ai.izdrail.com
AI_MODEL=gemma4:e2b
AI_API_KEY=
LEADSCAPTAIN_BASE_URL=
LEADSCAPTAIN_API_TOKEN=
EMAIL_VALIDATION_URL=
EMAIL_VALIDATION_API_KEY=
APP_API_KEY=changeme

# UI login screen. When BOTH are set, the web UI asks for a username/password
# before any API data loads (session cookie, 7-day expiry). Leave empty to run
# without a login screen.
AUTH_USERNAME=
AUTH_PASSWORD=
# Optional: key used to sign session cookies. Defaults to a key derived from
# the credentials above; set it to keep sessions valid across credential changes.
AUTH_SESSION_SECRET=
AGENT_MAX_ITERATIONS=50
AGENT_MAX_TASKS=500
CORS_ALLOWED_ORIGINS=*

# Optional free-tier enrichments (all fail safe when unset)
# UK Companies House Public Data API - free key: https://developer.company-information.service.gov.uk/
# (FR, RO and EU VIES lookups need no key at all)
COMPANIES_HOUSE_API_KEY=
# Where the export_leads tool writes CSV files
EXPORT_DIR=./data/exports
