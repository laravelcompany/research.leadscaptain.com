APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=7001
# Ephemeral by design: the local working database starts fresh with each container.
DATABASE_PATH=/tmp/research-leads/leads.db
AI_BASE_URL=https://ai.izdrail.com
AI_MODEL=gemma4:e2b
AI_API_KEY=
LEADSCAPTAIN_BASE_URL=https://api.leadscaptain.com
LEADSCAPTAIN_API_TOKEN=
# LaravelMail is the primary verifier; override this base URL for another deployment.
EMAIL_VALIDATION_URL=https://validation.laravelmail.com
# Optional forward-compatible bearer token; the current endpoint is keyless.
EMAIL_VALIDATION_API_KEY=
APP_API_KEY=changeme

# LinkedIn OpenID Connect authentication (required for browser access).
# Register this exact redirect URL in the LinkedIn Developer Portal.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URL=https://research.leadscaptain.com/api/v1/auth/callback
# LinkedIn OIDC discovery issuer and least-privilege sign-in scopes.
LINKEDIN_ISSUER_URL=https://www.linkedin.com/oauth
LINKEDIN_SCOPES=openid profile email
# Required independent secret used to sign the local HttpOnly session cookie.
# Generate with: openssl rand -base64 48
AUTH_SESSION_SECRET=
AGENT_MAX_ITERATIONS=50
AGENT_MAX_TASKS=500
CORS_ALLOWED_ORIGINS=*

# Optional free-tier enrichments (all fail safe when unset)
# UK Companies House Public Data API - free key: https://developer.company-information.service.gov.uk/
# (FR, RO and EU VIES lookups need no key at all)
COMPANIES_HOUSE_API_KEY=
# Optional: Clearbit Company API key for employee counts, revenue estimates and
# richer firmographics on the Companies page. Without it the page still works:
# keyless autocomplete, official registries and website signals are used.
CLEARBIT_API_KEY=
# Ephemeral CSV exports; use /tmp so container restarts clear them with the DB.
EXPORT_DIR=/tmp/research-leads/exports
